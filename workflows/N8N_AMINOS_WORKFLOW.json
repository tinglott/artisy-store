            { "name": "action", "value": "update_status" },
            { "name": "order_id", "value": "={{ $json.order_id }}" },
            { "name": "status", "value": "={{ $json.success ? 'delivered' : 'failed' }}" },
            { "name": "bot_id", "value": "={{ $json.bot_id }}" },
            { "name": "preview_url", "value": "={{ $json.preview_url }}" }
          ]
        }
      },
      "id": "update-nexus-status",
      "name": "Update NEXUS Order Status",
      "type": "n8n-nodes-base.httpRequest",
