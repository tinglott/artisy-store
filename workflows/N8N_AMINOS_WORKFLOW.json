        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "from", "value": "hello@mail.artistrystore.com" },
            { "name": "to", "value": "tinglott@gmail.com" },
            { "name": "subject", "value": "⚠️ Bot Build Failed — Manual Action Needed" },
            { "name": "html", "value": "=<p>Order {{ $json.order_id }} failed to build.<br>Customer: {{ $json.customer_email }}<br>Error: {{ $json.error }}<br><br>Login to app.aminos.ai and build manually.</p>" }
          ]
        }
      },
