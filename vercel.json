{
  "version": 2,
  "builds": [
    {
      "src": "nexus-triple-agent/nexus-integration-hub-v2.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/index\\.html$",
      "dest": "/index.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "nexus-triple-agent/nexus-integration-hub-v2.js"
    }
  ]
}
