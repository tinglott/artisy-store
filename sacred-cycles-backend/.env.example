# Port (Replit sets this automatically)
PORT=3001

# CORS — set to your live store URL
ALLOWED_ORIGINS=https://shop.artistrystore.com

# Admin API key (choose any strong random string)
ADMIN_API_KEY=change_me_to_something_secret

# Optional SMTP for welcome emails (leave blank to skip)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=Sacred Cycles Renewal <no-reply@artistrystore.com>

# Optional: override SQLite data directory
# DB_DIR=/data
